#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y python3-venv python3-pip unzip curl
curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscli.zip
unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install

apt-get install -y nginx

rm -f /etc/nginx/sites-enabled/default
cat > /etc/nginx/conf.d/callcenter.conf <<'NGINX'
server {
	listen 80 default_server;
	server_name _;

	location / {
		proxy_pass http://127.0.0.1:8000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_read_timeout 60s;
	}
}
NGINX
nginx -t
systemctl enable nginx
systemctl restart nginx

cat > /usr/local/bin/cc-deploy.sh <<'DEPLOY'
#!/bin/bash
set -euo pipefail
export AWS_DEFAULT_REGION=${region}
APP=/opt/callcenter
mkdir -p $APP
aws s3 cp s3://${artifact_bucket}/backend.tgz /tmp/backend.tgz
tar -xzf /tmp/backend.tgz -C $APP
cd $APP
[ -d venv ] || python3 -m venv venv
venv/bin/pip install -q -r requirements.txt

get() { aws ssm get-parameter --with-decryption --name "/${name}/$1" --query Parameter.Value --output text; }
{
  echo "DATABASE_URL=$(get DATABASE_URL)"
  echo "JWT_SECRET=$(get JWT_SECRET)"
  EL=$(get ELEVENLABS_API_KEY)
  [ "$EL" = "unset" ] || echo "ELEVENLABS_API_KEY=$EL"
} > /etc/callcenter.env
chmod 600 /etc/callcenter.env

cd $APP/backend
set -a; . /etc/callcenter.env; set +a
$APP/venv/bin/python -m app.seed

systemctl restart callcenter
DEPLOY
chmod +x /usr/local/bin/cc-deploy.sh

cat > /etc/systemd/system/callcenter.service <<'UNIT'
[Unit]
Description=Callcenter API
After=network.target

[Service]
WorkingDirectory=/opt/callcenter/backend
EnvironmentFile=/etc/callcenter.env
ExecStart=/opt/callcenter/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable callcenter
touch /var/lib/cc-bootstrap-done
